<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WorldAtWarVR_Launcher.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Grid x:Name="PageShell" Background="Transparent">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <Grid x:Name="ContentRoot" Padding="48,24,48,24">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="ContrastStates">
                        <VisualState x:Name="StandardContrast" />
                        <VisualState x:Name="HighContrast">
                            <VisualState.StateTriggers>
                                <StateTrigger IsActive="{x:Bind IsHighContrast}" />
                            </VisualState.StateTriggers>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <StackPanel MaxWidth="1320" HorizontalAlignment="Stretch" Spacing="15">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="GAME INSTALLATION" />
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="164" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="GamePathTextBox"
                                AutomationProperties.Name="Call of Duty: World at War installation folder"
                                PlaceholderText="Select the folder containing CoDWaW.exe"
                                Style="{StaticResource LauncherTextBoxStyle}"
                                TextChanged="GamePathTextBox_TextChanged" />
                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.HelpText="Open a folder picker"
                                Click="BrowseButton_Click"
                                Content="Browse"
                                Style="{StaticResource LauncherSecondaryButtonStyle}" />
                        </Grid>
                        <Grid MinHeight="30" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="24" Height="24" VerticalAlignment="Center">
                                <Ellipse
                                    x:Name="InstallationStatusRing"
                                    Fill="#18000000"
                                    Stroke="{StaticResource LauncherAccentBrush}"
                                    StrokeThickness="2" />
                                <FontIcon
                                    x:Name="InstallationStatusIcon"
                                    FontSize="13"
                                    Foreground="{StaticResource LauncherAccentBrush}"
                                    Glyph="&#xE73E;" />
                                <ProgressRing
                                    x:Name="InstallationProgressRing"
                                    Width="24"
                                    Height="24"
                                    Foreground="{StaticResource LauncherAccentBrush}"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                            </Grid>
                            <TextBlock
                                x:Name="InstallationStatusText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource LauncherAccentBrush}"
                                FontFamily="{StaticResource LauncherBodyFont}"
                                FontSize="16"
                                Text="Select your game installation" />
                        </Grid>
                        <InfoBar
                            x:Name="InstallationInfoBar"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Informational"
                            Title="Select your game" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="LAUNCH TARGET" />
                        <Grid x:Name="LaunchTargetGrid" ColumnSpacing="20" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton
                                x:Name="MainMenuRadio"
                                AutomationProperties.Name="Main Menu, Zombies and Campaign"
                                Checked="LaunchTarget_Checked"
                                GroupName="LaunchTarget"
                                Style="{StaticResource LauncherChoiceStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontFamily="{StaticResource LauncherDisplayFont}"
                                        FontSize="24"
                                        FontStretch="Condensed"
                                        FontWeight="SemiBold"
                                        Text="Main Menu" />
                                    <TextBlock
                                        FontSize="16"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Zombies and Campaign" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                x:Name="MultiplayerRadio"
                                Grid.Column="1"
                                AutomationProperties.Name="Experimental local offline Multiplayer"
                                Checked="LaunchTarget_Checked"
                                GroupName="LaunchTarget"
                                Style="{StaticResource LauncherChoiceStyle}">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock
                                            FontFamily="{StaticResource LauncherDisplayFont}"
                                            FontSize="24"
                                            FontStretch="Condensed"
                                            FontWeight="SemiBold"
                                            Text="Multiplayer" />
                                        <Border
                                            Padding="8,3"
                                            VerticalAlignment="Center"
                                            Background="#28130A05"
                                            BorderBrush="{StaticResource LauncherAccentDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                            <TextBlock
                                                Foreground="{StaticResource LauncherAccentBrush}"
                                                FontFamily="{StaticResource LauncherDisplayFont}"
                                                FontSize="12"
                                                FontStretch="Condensed"
                                                FontWeight="SemiBold"
                                                Text="EXPERIMENTAL" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="16"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Local and offline play" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                        <InfoBar
                            x:Name="MultiplayerInfoBar"
                            IsClosable="False"
                            IsOpen="False"
                            Message="Online multiplayer is not supported or tested. Some local maps or modes may not work."
                            Severity="Warning"
                            Title="Local and offline only" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="LOCAL MULTIPLAYER" />
                        <CheckBox
                            x:Name="BotsCheckBox"
                            AutomationProperties.HelpText="Automatically load compatible bots for local offline multiplayer"
                            Checked="SettingControl_Changed"
                            Style="{StaticResource LauncherBotToggleStyle}"
                            Unchecked="SettingControl_Changed">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontFamily="{StaticResource LauncherBodyFont}"
                                    FontSize="19"
                                    Text="Enable automatic bots" />
                                <TextBlock
                                    FontSize="15"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Adds bots when launching local multiplayer." />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="ZOMBIES &amp; CAMPAIGN CONTROLS" />
                        <CheckBox
                            x:Name="AutomaticReloadCheckBox"
                            AutomationProperties.HelpText="Use the A button to perform the game's conventional full reload"
                            Checked="SettingControl_Changed"
                            Style="{StaticResource LauncherBotToggleStyle}"
                            Unchecked="SettingControl_Changed">
                            <StackPanel Spacing="2">
                                <TextBlock FontFamily="{StaticResource LauncherBodyFont}" FontSize="19" Text="Automatic Reload" />
                                <TextBlock FontSize="15" Style="{StaticResource SecondaryTextStyle}" Text="A performs the original full reload instead of manual reloading in Zombies and Campaign." />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox
                            x:Name="ButtonGrenadesCheckBox"
                            AutomationProperties.HelpText="Use the left index trigger to perform the game's conventional grenade throw"
                            Checked="SettingControl_Changed"
                            Style="{StaticResource LauncherBotToggleStyle}"
                            Unchecked="SettingControl_Changed">
                            <StackPanel Spacing="2">
                                <TextBlock FontFamily="{StaticResource LauncherBodyFont}" FontSize="19" Text="Button Grenades" />
                                <TextBlock FontSize="15" Style="{StaticResource SecondaryTextStyle}" Text="Left index trigger performs the original frag-grenade throw in Zombies and Campaign." />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="TURNING" />
                        <CheckBox
                            x:Name="SmoothTurningCheckBox"
                            AutomationProperties.HelpText="Turn continuously with the right stick instead of using snap turns"
                            Checked="SettingControl_Changed"
                            Style="{StaticResource LauncherBotToggleStyle}"
                            Unchecked="SettingControl_Changed">
                            <StackPanel Spacing="2">
                                <TextBlock FontFamily="{StaticResource LauncherBodyFont}" FontSize="19" Text="Smooth Turning" />
                                <TextBlock FontSize="15" Style="{StaticResource SecondaryTextStyle}" Text="Right stick turns continuously instead of using snap turns." />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="HEADSET COMPATIBILITY" />
                        <CheckBox
                            x:Name="AirLinkSteamVrCheckBox"
                            AutomationProperties.HelpText="Use SteamVR's registered 32-bit OpenXR runtime while the Quest remains connected through Air Link"
                            Checked="SettingControl_Changed"
                            Style="{StaticResource LauncherBotToggleStyle}"
                            Unchecked="SettingControl_Changed">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontFamily="{StaticResource LauncherBodyFont}"
                                    FontSize="19"
                                    Text="Quest Air Link compatibility" />
                                <TextBlock
                                    FontSize="15"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Uses SteamVR's 32-bit OpenXR runtime. Requires SteamVR." />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="VR QUALITY" />
                        <Grid x:Name="QualityGrid" ColumnSpacing="20" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton
                                x:Name="NativeRadio"
                                AutomationProperties.Name="Native plus scopes recommended, 6016 by 2688 packed render source"
                                Checked="ResolutionRadio_Checked"
                                GroupName="ResolutionPreset"
                                Style="{StaticResource LauncherChoiceStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontFamily="{StaticResource LauncherDisplayFont}"
                                        FontSize="21"
                                        FontStretch="Condensed"
                                        FontWeight="SemiBold"
                                        Text="Native" />
                                    <TextBlock FontSize="15" Style="{StaticResource SecondaryTextStyle}" Text="6016 × 2688" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                x:Name="PerformanceRadio"
                                Grid.Column="1"
                                AutomationProperties.Name="Performance, 3744 by 2016 packed stereo"
                                Checked="ResolutionRadio_Checked"
                                GroupName="ResolutionPreset"
                                Style="{StaticResource LauncherChoiceStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontFamily="{StaticResource LauncherDisplayFont}"
                                        FontSize="21"
                                        FontStretch="Condensed"
                                        FontWeight="SemiBold"
                                        Text="Performance" />
                                    <TextBlock FontSize="15" Style="{StaticResource SecondaryTextStyle}" Text="3744 × 2016" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                x:Name="RecoveryRadio"
                                Grid.Column="2"
                                AutomationProperties.Name="Recovery compatibility, 2560 by 1440 packed stereo"
                                Checked="ResolutionRadio_Checked"
                                GroupName="ResolutionPreset"
                                Style="{StaticResource LauncherChoiceStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontFamily="{StaticResource LauncherDisplayFont}"
                                        FontSize="21"
                                        FontStretch="Condensed"
                                        FontWeight="SemiBold"
                                        Text="Recovery" />
                                    <TextBlock FontSize="15" Style="{StaticResource SecondaryTextStyle}" Text="2560 × 1440" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                        <TextBlock
                            x:Name="ResolutionDetailText"
                            Foreground="{StaticResource LauncherMutedTextBrush}"
                            FontFamily="{StaticResource LauncherBodyFont}"
                            FontSize="13"
                            Text="Full 2496 × 2688 per eye plus a sharp 1024 × 1024 physical scope camera · 6016 × 2688 packed source"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <Border
                        Margin="-48,0,-48,-24"
                        Padding="48,16,48,14"
                        Background="#E311100E"
                        BorderBrush="{StaticResource LauncherBorderBrush}"
                        BorderThickness="1,1,1,0">
                        <Grid x:Name="FooterGrid" ColumnSpacing="24" RowSpacing="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="FooterStatusPanel" MinHeight="74" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="40" Height="40" VerticalAlignment="Center">
                                    <Ellipse
                                        x:Name="ReadyStatusRing"
                                        Fill="#18000000"
                                        Stroke="{StaticResource LauncherAccentBrush}"
                                        StrokeThickness="2" />
                                    <FontIcon
                                        x:Name="ReadyStatusIcon"
                                        FontSize="20"
                                        Foreground="{StaticResource LauncherAccentBrush}"
                                        Glyph="&#xE73E;" />
                                    <ProgressRing
                                        x:Name="BusyProgressRing"
                                        Width="38"
                                        Height="38"
                                        Foreground="{StaticResource LauncherAccentBrush}"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock
                                        x:Name="LaunchSummaryText"
                                        Foreground="{StaticResource LauncherSecondaryTextBrush}"
                                        FontFamily="{StaticResource LauncherBodyFont}"
                                        FontSize="19"
                                        Text="Select a supported game installation to continue."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="ActivityStatusText"
                                        Foreground="{StaticResource LauncherMutedTextBrush}"
                                        FontFamily="{StaticResource LauncherBodyFont}"
                                        FontSize="13"
                                        Text="Settings are saved automatically."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="ReleaseProviderNoticeText"
                                        Foreground="{StaticResource LauncherMutedTextBrush}"
                                        FontFamily="{StaticResource LauncherBodyFont}"
                                        FontSize="12"
                                        Text="Get updates, known issues, and support from the service where you received this release."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <StackPanel
                                x:Name="LaunchActionPanel"
                                Grid.Column="1"
                                MinWidth="330"
                                HorizontalAlignment="Right"
                                Spacing="2">
                                <Button
                                    x:Name="LaunchButton"
                                    MinWidth="330"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.HelpText="Start the selected game target in virtual reality"
                                    Click="LaunchButton_Click"
                                    Content="LAUNCH IN VR"
                                    IsEnabled="False"
                                    Style="{StaticResource LauncherPrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
