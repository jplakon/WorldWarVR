{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "win32-debug",
      "displayName": "Windows x86 Debug",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/win32-debug",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "WAWVR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "win32-release",
      "displayName": "Windows x86 Release",
      "inherits": "win32-debug",
      "binaryDir": "${sourceDir}/build/win32-release"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "win32-debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "win32-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "win32-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
